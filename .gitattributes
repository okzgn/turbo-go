# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts always with LF, also in a Windows copy
*.sh text eol=lf

# The GUI is embedded as it is in the binary (//go:embed): with LF, the binary is
# the same wherever it is built.
turbo.dev/**/*.html text eol=lf
turbo.dev/**/*.css text eol=lf
