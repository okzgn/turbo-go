# Unidad systemd de referencia para Turbo.
#
# Instalación (ejemplo con el binario y los sitios en /home/server/):
#   sudo useradd --system --home-dir /home/server --shell /usr/sbin/nologin turbo
#   sudo chown -R turbo:turbo /home/server
#   sudo cp turbo.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now turbo
#   journalctl -u turbo -f     # mensajes de Turbo (stdout) con nivel y hora
#
# Turbo corre sin privilegios: CAP_NET_BIND_SERVICE le deja abrir los puertos
# 80 y 443. Los CGI y Certbot se ejecutan como el usuario turbo. Certbot
# trabaja en turbo.certificates/ dentro del directorio de sitios; si se usa
# otra configuración de Certbot que escriba en /etc/letsencrypt, añádala a
# ReadWritePaths.
#
# El panel (/admin:) debe tener un host propio que no sirva ningún sitio, por
# ejemplo admin.ejemplo.com con su certificado, configurado en "Dónde responde
# el panel" (PA): con PA vacío responde en los hosts de los sitios y una
# página servida por Turbo comparte su origen. Turbo lo avisa al arrancar.
#
# Detrás de un proxy, Turbo puede escuchar en otras direcciones, por ejemplo:
#   Environment=TURBO_HTTP_ADDR=127.0.0.1:8080
#   Environment=TURBO_HTTPS_ADDR=127.0.0.1:8443
# Solo si las dos usan puertos por encima de 1023 deja de necesitar
# CAP_NET_BIND_SERVICE: sin TURBO_HTTPS_ADDR, HTTPS sigue en :443.

[Unit]
Description=Turbo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turbo
Group=turbo
WorkingDirectory=/home/server/
ExecStart=/home/server/turbo
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/server/
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
